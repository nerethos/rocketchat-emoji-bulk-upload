ROCKETCHAT_SERVER_URL=https://your-rocketchat-server-url
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Alternative to username/password: authenticate with a Personal Access Token.
# If both of these are set, they take priority and username/password are ignored.
# Generate a token from My Account > Personal Access Tokens; the same page/API
# call also gives you the paired ROCKETCHAT_USER_ID.
ROCKETCHAT_AUTH_TOKEN=your-personal-access-token
ROCKETCHAT_USER_ID=your-user-id